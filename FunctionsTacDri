// Função principal
function calcularNutrientes(consumo) {
  const totais = {
    vitA: 0, vitD: 0, vitE: 0, vitK: 0,
    vitC: 0, vitB1: 0, vitB2: 0, vitB3: 0, vitB5: 0, vitB6: 0, vitB12: 0, folato: 0,
    calcio: 0, ferro: 0, zinco: 0, magnesio: 0, fosforo: 0, sodio: 0, potassio: 0
  };

  for (const item of consumo) {
    const alimento = alimentos.find(a => a.nome.toLowerCase() === item.nome.toLowerCase());
    if (!alimento) {
      console.log(`⚠️ Alimento não encontrado: ${item.nome}`);
      continue;
    }

    const fator = item.quantidade / 100;

    // Soma todas as vitaminas e minerais
    for (let chave in totais) {
      totais[chave] += alimento[chave] * fator;
    }
  }

  return {
    lipossoluveis: {
      A: totais.vitA,
      D: totais.vitD,
      E: totais.vitE,
      K: totais.vitK
    },
    hidrossoluveis: {
      C: totais.vitC,
      B1: totais.vitB1,
      B2: totais.vitB2,
      B3: totais.vitB3,
      B5: totais.vitB5,
      B6: totais.vitB6,
      B12: totais.vitB12,
      Folato: totais.folato
    },
    minerais: {
      Calcio: totais.calcio,
      Ferro: totais.ferro,
      Zinco: totais.zinco,
      Magnesio: totais.magnesio,
      Fosforo: totais.fosforo,
      Sodio: totais.sodio,
      Potassio: totais.potassio
    }
  };
}
